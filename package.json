{
  "name": "cuotaclara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador local-first de préstamos y estrategias de pago.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:sync": "node tooling/docs-status.mjs --write && node tooling/backlog-status.mjs --write",
    "docs:check": "node tooling/docs-status.mjs --check && node tooling/backlog-status.mjs --check",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project packages/domain/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "commit:check": "commitlint --edit",
    "verify": "node tooling/docs-status.mjs --check && node tooling/backlog-status.mjs --check && prettier --check . && eslint . && tsc --noEmit --project packages/domain/tsconfig.json && vitest run --passWithNoTests"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
